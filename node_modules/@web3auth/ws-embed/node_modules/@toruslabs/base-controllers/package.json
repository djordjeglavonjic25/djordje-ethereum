    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@toruslabs/broadcast-channel": "^13.3.0",
    "@toruslabs/http-helpers": "^9.0.0",
    "@toruslabs/metadata-helpers": "^8.2.0",
    "@web3auth/auth": "^11.8.1",
    "async-mutex": "^0.5.0",
    "bowser": "^2.14.1",
    "events": "^3.3.0",
    "jwt-decode": "^4.0.0",
    "loglevel": "^1.9.2",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@types/readable-stream": "^4.0.23",
    "global": "^4.4.0",
    "typed-emitter": "^2.1.0",
    "util": "^0.12.5"
  },
  "peerDependencies": {
    "@babel/runtime": "7.x"
  },
  "files": [
    "dist"
