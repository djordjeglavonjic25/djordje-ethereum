{
  "name": "@toruslabs/session-manager",
  "version": "5.6.0",
  "description": "session manager web",
  "sideEffects": false,
  "main": "dist/lib.cjs/index.js",
  "module": "dist/lib.esm/index.js",
  "unpkg": "dist/lib.esm/index.js",
  "jsdelivr": "dist/lib.esm/index.js",
  "types": "dist/lib.cjs/types/index.d.ts",
  "repository": "git@github.com:torusresearch/session-manager-web.git",
  "scripts": {
    "start": "cross-env FORCE_COLOR=1 torus-scripts start",
    "dev": "rimraf dist/ && cross-env NODE_ENV=development torus-scripts start",
    "build": "torus-scripts build",
    "release": "torus-scripts release",
    "lint": "torus-scripts lint",
    "prepack": "npm run build",
    "pre-commit": "lint-staged --cwd .",
    "prepare": "husky",
    "test": "vitest run --config=test/config/node.config.mts --coverage"
  },
  "dependencies": {
    "@toruslabs/eccrypto": "^7.0.0",
    "@toruslabs/http-helpers": "^9.0.0",
    "@toruslabs/metadata-helpers": "^8.2.0"
  },
  "devDependencies": {
    "@babel/register": "^7.28.6",
    "@babel/runtime": "^7.29.2",
    "@toruslabs/config": "^4.0.0",
    "@toruslabs/eslint-config-typescript": "^5.0.1",
    "@toruslabs/torus-scripts": "^8.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25",
    "@vitest/coverage-istanbul": "^4.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.59.0"
  },
  "author": "Torus Labs",
  "license": "MIT",
  "lint-staged": {
    "!(*d).{js,ts}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.x",
    "npm": ">=10.x"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
